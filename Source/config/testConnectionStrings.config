<connectionStrings>
  <clear/>
  <!-- Cloud-ready connection strings using environment variables -->
  <!-- Configure these via AWS Secrets Manager, Parameter Store, or environment variables:
       - DB_CONNECTION_STRING: Main database connection
       - DB_EF_CONNECTION_STRING: Entity Framework connection
       - DB_INVALID_CONNECTION_STRING: Test invalid database connection
       - DB_INVALID_EF_CONNECTION_STRING: Test invalid EF connection
  -->
  <add name="DataPortalTestDatabase"
    connectionString=""
    providerName="System.Data.SqlClient" />
  <add name="DataPortalTestDatabaseEntities"
    connectionString=""
    providerName="System.Data.EntityClient" />
  <add name="DataPortalTestDatabaseWithInvalidDBValue"
    connectionString=""
    providerName="System.Data.SqlClient" />
  <add name="DataPortalTestDatabaseEntitiesWithInvalidDBValue"
    connectionString=""
    providerName="System.Data.EntityClient" />
</connectionStrings>  
